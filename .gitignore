# =============================================================================
# OorjaMan flagship monorepo — single root gitignore (all apps + packages)
# Track source; ignore secrets, caches, build outputs, local tooling, media dumps
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# -----------------------------------------------------------------------------
# Environment & secrets (commit only *.env.example templates)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Service account / mobile push keys (never commit)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist
**/secrets/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
.venv*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~
*.bak
*.orig
.vscode/*
!.vscode/extensions.json

# Cursor: keep shared rules + MCP example; ignore local MCP config / state
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/mcp.json.example

# -----------------------------------------------------------------------------
# TypeScript / JS tooling caches
# -----------------------------------------------------------------------------
*.tsbuildinfo
**/*.tsbuildinfo
.turbo/
.cache/
.parcel-cache/
.eslintcache
.prettiercache
.npm/

# -----------------------------------------------------------------------------
# Test & coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# -----------------------------------------------------------------------------
# Local scratch / tool venvs (never commit)
# -----------------------------------------------------------------------------
/tmp/
.venv-docgen/
.venv-docx/

# -----------------------------------------------------------------------------
# Web apps - Vite (admin-web, vendor-web, support-web)
# -----------------------------------------------------------------------------
**/dist/
**/dist-ssr/
**/.vite/
# Local GoDaddy upload packages (npm run build portals → zip)
/dist-godaddy/

# -----------------------------------------------------------------------------
# Web app - Next.js (oorjaman-web)
# -----------------------------------------------------------------------------
**/.next/
**/next-env.d.ts

# -----------------------------------------------------------------------------
# Mobile apps - Expo / React Native (customer-app, technician-app)
# -----------------------------------------------------------------------------
**/.expo/
**/.expo-shared/
**/web-build/
**/expo-env.d.ts
**/.metro-health-check*
**/.metro/
*.jsbundle
*.hbc
*.hprof

# Expo / RN local example scaffold
**/app-example/

# EAS Build
**/.eas/
eas-build-local/
*.tar.gz

# -----------------------------------------------------------------------------
# Native projects — generated by `npx expo prebuild` (do not commit)
# Regenerate locally: `npm run ios:rebuild` or `npm run android:rebuild`
# Source of truth: app.config.ts + plugins/
# -----------------------------------------------------------------------------
apps/customer-app/ios/
apps/customer-app/android/
apps/technician-app/ios/
apps/technician-app/android/

# Native build artifacts (belt-and-suspenders if paths change)
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/**/*.xcworkspace/xcuserdata/
**/ios/**/*.xcodeproj/xcuserdata/
**/ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/
**/.xcode.env.local
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.xcscmblueprint
*.xcuserstate
*.ipa

**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/local.properties
**/android/.idea/
**/android/captures/
**/android/.cxx/
*.apk
*.aab
*.dex
*.keystore
!**/android/app/debug.keystore

# -----------------------------------------------------------------------------
# Brand print CLI outputs (generate via Admin → Brand print or npm run brand:print)
# -----------------------------------------------------------------------------
brand/print/**/*.pdf
brand/print/**/*.png
brand/print/**/*.svg
brand/print/**/*.html

# -----------------------------------------------------------------------------
# Shared build output (packages, if added later)
# -----------------------------------------------------------------------------
**/build/
**/out/
*.tgz

# -----------------------------------------------------------------------------
# Supabase CLI local state (commit migrations/, schema.sql, functions/)
# -----------------------------------------------------------------------------
supabase/.branches/
supabase/.temp/

# -----------------------------------------------------------------------------
# Hosting / deploy platform local config
# -----------------------------------------------------------------------------
.vercel
.netlify

# -----------------------------------------------------------------------------
# Misc local-only overrides (Vite host files, scratch notes)
# -----------------------------------------------------------------------------
*.local

# -----------------------------------------------------------------------------
# Future-film — track scripts/assets; ignore venv, work, score, renders
# -----------------------------------------------------------------------------
scripts/future-film/.venv/
scripts/future-film/work/
scripts/future-film/output/
scripts/future-film/audio/score.*
scripts/future-film/**/*.mp4
scripts/future-film/**/*.wav
scripts/future-film/**/*.aiff

# -----------------------------------------------------------------------------
# Product-demo — track engine + source assets only
# Keep: *.py / *.mjs / *.sh / README / .env.example / config JSON /
#       voiceover-beats.json / voiceover.txt / audio/score.mp3 /
#       production/assets (evidence + phone frame; not previews)
# Ignore: run outputs, rendered film, generated VO stems
# -----------------------------------------------------------------------------
# Scratch / legacy local trees
scripts/product-demo/work/
scripts/product-demo/output/
scripts/product-demo/recordings/

# Run + render outputs (keep empty dirs via .gitkeep)
scripts/product-demo/production/raw/**
!scripts/product-demo/production/raw/.gitkeep
scripts/product-demo/production/failed-runs/**
!scripts/product-demo/production/failed-runs/.gitkeep
# Global `logs/` ignores any logs/ dir — re-open this one, then ignore contents
!scripts/product-demo/production/logs/
scripts/product-demo/production/logs/**
!scripts/product-demo/production/logs/.gitkeep
scripts/product-demo/production/events/**
!scripts/product-demo/production/events/.gitkeep
scripts/product-demo/production/rendered/**
!scripts/product-demo/production/rendered/.gitkeep

# Generated narration / mix artifacts (regenerate via build-demo.sh)
scripts/product-demo/production/audio/_beats/
scripts/product-demo/production/audio/*.wav
scripts/product-demo/production/audio/*.aiff
scripts/product-demo/production/audio/*.mp3
scripts/product-demo/production/audio/voiceover-meta.json
scripts/product-demo/production/audio/voiceover-placements.json
scripts/product-demo/production/audio/brand-sts-meta.json

# Derived / non-pipeline assets
scripts/product-demo/production/assets/phone-frame-preview.jpg

# Accidental media dumps (score.mp3 lives under audio/ and stays trackable)
scripts/product-demo/**/*.mp4
scripts/product-demo/**/*.srt
