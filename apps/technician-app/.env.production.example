# Prod EAS / local prod smoke test. Copy to .env.production.local (gitignored).
# Prefer EAS Secrets for store builds — see DEPLOYMENT.md / PROD_MOBILE_ANDROID_LAUNCH.md.
# UAT local APK scripts temporarily bake `.env.uat.local` into `.env.production.local` then restore.

EXPO_PUBLIC_DEPLOY_ENV=production
EXPO_PUBLIC_SUPABASE_URL=https://nppfpegqnmclbcmmogux.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_prod_anon_key
EXPO_PUBLIC_SITE_URL=https://oorjaman.com

# Prod auth: real Email OTP via Supabase (+ custom SMTP / Resend). Never enable dummy auth.
# EXPO_PUBLIC_USE_DUMMY_AUTH is hard-disabled when DEPLOY_ENV=production — leave it unset.
# SMS / mobile OTP is Coming soon in the app until India SMS is live.

# Optional (not required for Partner store launch):
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
