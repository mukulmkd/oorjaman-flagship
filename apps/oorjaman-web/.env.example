# Deploy tier: production (indexable) | uat (noindex - see DEPLOYMENT.md)
NEXT_PUBLIC_DEPLOY_ENV=production
NEXT_PUBLIC_SITE_URL=https://oorjaman.com

# Partner signup CTA — must be public https (never localhost) for production builds.
# If unset, /partners shows email apply instead of a portal button.
NEXT_PUBLIC_VENDOR_PORTAL_URL=https://vendor.oorjaman.com

# Customer store listings — leave blank until App Store / Play URLs are live.
# When both are set to https URLs, /download shows store buttons.
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.oorjaman.customer

# Optional — only when the real company GSTIN is verified:
NEXT_PUBLIC_COMPANY_GSTIN=18AAKFO2664E1Z5

# Registered office (full postal address). Default is a dummy Guwahati address - replace with LLP records.
NEXT_PUBLIC_COMPANY_ADDRESS=House No. 18, Bye Lane 2, Zoo Road Tiniali, Guwahati, Assam 781001, India

# Required before public launch (Indian grievance / DPDP expectations): named officer
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Priya Sharma

# Support phone (code defaults to +91 80 4567 8900 until you set the real line)
NEXT_PUBLIC_SUPPORT_PHONE=+91 80 4567 8900

# Optional support hours line in footer (default: Mon-Sat, 9:00 AM - 6:00 PM IST)
NEXT_PUBLIC_SUPPORT_HOURS=Mon-Sat, 9:00 AM - 6:00 PM IST

# Instagram (defaults to https://www.instagram.com/oorjaman/)
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/oorjaman/

# Optional analytics — leave unset to keep tracking fully off.
# When set (production only), GA4 loads ONLY after the visitor accepts cookies.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# UAT example:
# NEXT_PUBLIC_DEPLOY_ENV=uat
# NEXT_PUBLIC_SITE_URL=https://dev-oorjaman.oorjaman.com
# NEXT_PUBLIC_VENDOR_PORTAL_URL=https://dev-vendor.oorjaman.com

# Build: npm run build:godaddy -w oorjaman-web → upload out/ (see DEPLOYMENT.md)
