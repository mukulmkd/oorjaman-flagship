# Customer app - copy to .env (never commit real secrets).
# PROD vs UAT: DEPLOYMENT.md

EXPO_PUBLIC_DEPLOY_ENV=local
EXPO_PUBLIC_SUPABASE_URL=https://<uat-or-local-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Legal / marketing links
# EXPO_PUBLIC_SITE_URL=https://oorjaman.com
# UAT: EXPO_PUBLIC_SITE_URL=https://dev-oorjaman.oorjaman.com

# Universal Web (CSR) — see project-docs/WEB-UNIVERSAL.md
# Production web origin for this app (customer):
# EXPO_PUBLIC_WEB_ORIGIN=https://app.oorjaman.com
# Enable Razorpay Checkout.js on web only after Edge verify is proven (omit/off by default):
# EXPO_PUBLIC_WEB_PAYMENTS=0
# Public Razorpay key id (never the secret). Used by native SDK and web Checkout.js:
# EXPO_PUBLIC_RAZORPAY_KEY_ID=
# Browser Maps JavaScript API for live tracking on web — restrict HTTP referrers to app.oorjaman.com (+ Vercel previews):
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional platform-specific Maps keys for native builds:
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=

# QA only (omit on production EAS builds)
# EXPO_PUBLIC_USE_DUMMY_AUTH=true
# EXPO_PUBLIC_DUMMY_OTP_CODE=123456
# EXPO_PUBLIC_DUMMY_AUTH_PASSWORD=TestOtp123!

# EXPO_PUBLIC_EAS_PROJECT_ID=
