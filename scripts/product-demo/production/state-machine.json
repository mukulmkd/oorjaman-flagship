{
  "version": 1,
  "product": "OorjaMan UAT — real Customer + Technician apps",
  "notes": "States reflect actual implemented flows only. Technician does not Accept bookings in-app; assignment is ops/harness.",
  "states": [
    {
      "id": "PREPARED",
      "actor": "SYSTEM",
      "precondition": "emulators_online_packages_installed",
      "action": "clean_demo_bookings_authenticate_homes",
      "expected_result": "both_apps_on_home_authenticated",
      "backend_state": "idle_demo_accounts",
      "customer_ui_state": "home",
      "technician_ui_state": "home",
      "timeout_seconds": 180,
      "phase": "preflight"
    },
    {
      "id": "CUSTOMER_HOME",
      "actor": "CUSTOMER",
      "precondition": "customer_authenticated",
      "action": "assert_home",
      "expected_result": "home_visible",
      "backend_state": "n/a",
      "customer_ui_state": "Plan your next clean / Book a visit",
      "technician_ui_state": "home_or_jobs",
      "timeout_seconds": 30,
      "phase": "recording",
      "overlay": null
    },
    {
      "id": "SERVICE_SELECTED",
      "actor": "CUSTOMER",
      "precondition": "CUSTOMER_HOME",
      "action": "book_one_time_visit_once",
      "expected_result": "schedule_step_visible",
      "backend_state": "n/a",
      "customer_ui_state": "book_flow_schedule",
      "technician_ui_state": "unchanged",
      "timeout_seconds": 30,
      "phase": "recording",
      "overlay": null
    },
    {
      "id": "BOOKING_DETAILS",
      "actor": "CUSTOMER",
      "precondition": "SERVICE_SELECTED",
      "action": "select_tomorrow_slot_pay_after_once",
      "expected_result": "payment_step_visible",
      "backend_state": "n/a",
      "customer_ui_state": "payment_step",
      "technician_ui_state": "unchanged",
      "timeout_seconds": 30,
      "phase": "recording",
      "overlay": null
    },
    {
      "id": "BOOKING_CONFIRMED",
      "actor": "CUSTOMER",
      "precondition": "BOOKING_DETAILS",
      "action": "confirm_pay_later_once",
      "expected_result": "confirmation_visible",
      "backend_state": "booking_requested_or_confirmed",
      "customer_ui_state": "Booking confirmed",
      "technician_ui_state": "unchanged",
      "timeout_seconds": 30,
      "phase": "recording",
      "overlay": "BOOKING CONFIRMED"
    },
    {
      "id": "BOOKING_ASSIGNED",
      "actor": "SYSTEM",
      "precondition": "BOOKING_CONFIRMED",
      "action": "assign_via_phase2_harness_once",
      "expected_result": "backend_accepted_with_codes",
      "backend_state": "accepted_assigned",
      "customer_ui_state": "may_still_show_confirmation",
      "technician_ui_state": "job_pending_visibility",
      "timeout_seconds": 60,
      "phase": "recording",
      "overlay": "TECHNICIAN ASSIGNED"
    },
    {
      "id": "TECHNICIAN_JOB_VISIBLE",
      "actor": "TECHNICIAN",
      "precondition": "BOOKING_ASSIGNED",
      "action": "open_jobs_upcoming_wait_reference_once",
      "expected_result": "reference_visible_under_upcoming",
      "backend_state": "accepted_assigned",
      "customer_ui_state": "unchanged",
      "technician_ui_state": "Upcoming list shows OM- reference",
      "timeout_seconds": 60,
      "phase": "recording",
      "overlay": "JOB RECEIVED"
    },
    {
      "id": "TECHNICIAN_JOB_OPENED",
      "actor": "TECHNICIAN",
      "precondition": "TECHNICIAN_JOB_VISIBLE",
      "action": "open_assigned_job_once",
      "expected_result": "job_detail_visible",
      "backend_state": "accepted_assigned",
      "customer_ui_state": "bookings_detail_optional",
      "technician_ui_state": "job_detail",
      "timeout_seconds": 30,
      "phase": "recording",
      "overlay": null
    },
    {
      "id": "CODES_ALIGNED",
      "actor": "BOTH",
      "precondition": "TECHNICIAN_JOB_OPENED",
      "action": "customer_open_booking_detail_once",
      "expected_result": "customer_shows_start_and_finish_codes",
      "backend_state": "accepted_assigned",
      "customer_ui_state": "Job Start Code / Job finish code",
      "technician_ui_state": "job_detail",
      "timeout_seconds": 30,
      "phase": "recording",
      "overlay": null
    },
    {
      "id": "TECHNICIAN_STARTED",
      "actor": "TECHNICIAN",
      "precondition": "CODES_ALIGNED",
      "action": "start_visit_enter_code_safety_selfie_timer_once",
      "expected_result": "timer_running_or_photo_prompts",
      "backend_state": "in_progress",
      "customer_ui_state": "status_may_update",
      "technician_ui_state": "execution",
      "timeout_seconds": 60,
      "phase": "recording",
      "overlay": "SERVICE IN PROGRESS"
    },
    {
      "id": "TECHNICIAN_PHOTOS_COMPLETED",
      "actor": "TECHNICIAN",
      "precondition": "TECHNICIAN_STARTED",
      "action": "upload_before_after_photos_once_each",
      "expected_result": "continue_to_finish_available",
      "backend_state": "in_progress",
      "customer_ui_state": "status_may_update",
      "technician_ui_state": "finish_code_step",
      "timeout_seconds": 60,
      "phase": "recording",
      "overlay": null
    },
    {
      "id": "TECHNICIAN_SUBMITTED",
      "actor": "TECHNICIAN",
      "precondition": "TECHNICIAN_PHOTOS_COMPLETED",
      "action": "enter_finish_code_submit_once",
      "expected_result": "submit_accepted",
      "backend_state": "completed",
      "customer_ui_state": "status_updating",
      "technician_ui_state": "completion_ack",
      "timeout_seconds": 45,
      "phase": "recording",
      "overlay": null
    },
    {
      "id": "SERVICE_COMPLETED",
      "actor": "BOTH",
      "precondition": "TECHNICIAN_SUBMITTED",
      "action": "verify_customer_reflects_completion",
      "expected_result": "customer_shows_completed_or_history",
      "backend_state": "completed",
      "customer_ui_state": "completed",
      "technician_ui_state": "done",
      "timeout_seconds": 30,
      "phase": "recording",
      "overlay": "SERVICE COMPLETED"
    },
    {
      "id": "END",
      "actor": "SYSTEM",
      "precondition": "SERVICE_COMPLETED",
      "action": "post_roll_stop_recording",
      "expected_result": "recordings_saved",
      "backend_state": "completed",
      "customer_ui_state": "final",
      "technician_ui_state": "final",
      "timeout_seconds": 20,
      "phase": "recording",
      "overlay": null
    }
  ]
}
